{
  "name": "@hieujojo/distributed-cache",
  "version": "0.1.4",
  "description": "Lightweight distributed cache built from scratch in TypeScript — consistent hashing, replication, eviction strategies (LRU/LFU/FIFO), TTL, cluster management, and TCP protocol",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "benchmark": "tsx src/benchmark/run.ts",
    "viz": "tsx src/visualization/server.ts",
    "demo": "tsx src/demo/quick.ts",
    "demo:full": "tsx src/demo/index.ts",
    "memory": "tsx src/benchmark/memory.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "distributed-cache",
    "consistent-hashing",
    "hash-ring",
    "cache",
    "lru",
    "lfu",
    "fifo",
    "eviction",
    "replication",
    "cluster",
    "tcp",
    "typescript",
    "nodejs",
    "distributed-systems",
    "in-memory",
    "ttl",
    "failover",
    "leader-election"
  ],
  "author": "Truong Cong Hieu <conghieuzc112@gmail.com> (https://github.com/hieujojo)",
  "license": "MIT",
  "homepage": "https://distributed-cache-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hieujojo/distributed-cache.git",
    "directory": "packages/distributed-cache"
  },
  "bugs": {
    "url": "https://github.com/hieujojo/distributed-cache/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hieujojo"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.4.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "murmurhash": "^2.0.1"
  }
}
