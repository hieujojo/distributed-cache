{
  "name": "@hieujojo/distributed-cache",
  "version": "0.1.3",
  "description": "A lightweight distributed cache system implementing consistent hashing, data replication, and cache invalidation strategies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "benchmark": "tsx src/benchmark/run.ts",
    "viz": "tsx src/visualization/server.ts",
    "demo": "tsx src/demo/quick.ts",
    "demo:full": "tsx src/demo/index.ts",
    "memory": "tsx src/benchmark/memory.ts"
  },
  "keywords": [
    "distributed-cache",
    "consistent-hashing",
    "cache",
    "typescript",
    "distributed-systems"
  ],
  "author": "hieujojo",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.4.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hieujojo/distributed-cache.git"
  },
  "dependencies": {
    "murmurhash": "^2.0.1"
  }
}
